      "note": "the attribute block is built as {...{i: recipient}, ...payload}, so a payload field named i silently readdresses the attributes while rp still names the original recipient",
      "rust_error_category": "PayloadOverridesRecipient"
    },
    "an_embed_labelled_d_destroys_itself": {
      "raw": "{\"v\":\"KERI10JSON00016e_\",\"t\":\"exn\",\"d\":\"ECTxVycNaE2-LWTfd7-P_d1OpHz_Mvn8e-rjT-MucnW_\",\"i\":\"EIflL4H4134zYoRM6ls6Q086RLC_BhfNFh5uk-WxvhsL\",\"rp\":\"EAKUR-LmLHWMwXTLWQ1QjxHrihBmwwrV2tYaSG7hOrWj\",\"p\":\"\",\"dt\":\"2023-08-30T17:22:54.183000+00:00\",\"r\":\"/x\",\"q\":{},\"a\":{\"i\":\"EAKUR-LmLHWMwXTLWQ1QjxHrihBmwwrV2tYaSG7hOrWj\"},\"e\":{\"d\":\"EIeKlm9B5ul5vsHu_-OpjNmSf1kn1iMsyTb7rpuE4Ylc\"}}",
